# Copy to .env (never commit .env). Contains placeholders only, no real secrets.

# Plain `docker compose up` starts both services.
COMPOSE_PROFILES=bbb,edusync
# Windows fallback if the BBB container cannot run (EduSync only):
# COMPOSE_PROFILES=edusync

# Makes the ':' separator in COMPOSE_FILE work on Windows too (default there is ';').
COMPOSE_PATH_SEPARATOR=:

# Low-memory PCs (~6 GB): `scripts\dev.ps1 setup -Lite` appends :docker-compose.lite.yml to COMPOSE_FILE below.
# Sidecar networking (EduSync inside BBB's network namespace). Needs Compose >= 2.24.
# `scripts\dev.ps1 setup` manages the COMPOSE_FILE line below for BBB mode.
# COMPOSE_FILE=docker-compose.yml:docker-compose.sidecar.yml  # enable after the Phase-0 spike passes

# --- BigBlueButton ---
BBB_IMAGE=imdt/bigbluebutton:4.0.x-develop
BBB_HOSTNAME=bbb.test
# BBB_UDP_FROM=16384
# BBB_UDP_TO=16484

# --- EduSync ---
EDUSYNC_PORT=8100
# Left commented so EduSync starts as 'bbb: unconfigured'. `scripts\dev.ps1 first-run` fills the BBB values;
# with the sidecar override the Hasura/Redis 127.0.0.1 values are set automatically.
# EDUSYNC_BBB_URL=https://bbb.test/bigbluebutton/api
# Get via: just salt
EDUSYNC_BBB_SECRET=
# EDUSYNC_HASURA_URL=http://host.docker.internal:8085/v1/graphql
EDUSYNC_HASURA_ADMIN_SECRET=
# EDUSYNC_REDIS_URL=redis://host.docker.internal:6379
EDUSYNC_WHISPER_MODEL=base
