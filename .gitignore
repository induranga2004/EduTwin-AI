# EduSync blueprint_model: real datasets stay local (sample.csv and the README are kept).
# Model files under artifacts/ are committed through Git LFS (see .gitattributes).
edusync/packages/blueprint_model/data/*
!edusync/packages/blueprint_model/data/sample.csv
!edusync/packages/blueprint_model/data/README.md

# EduSync c2_difficulty_model: labels, lecture-derived caches and training runs stay local.
edusync/packages/c2_difficulty_model/data/
edusync/packages/c2_difficulty_model/cache/
edusync/packages/c2_difficulty_model/runs/

# Synthetic C2 decks are regenerated by scripts/make_synthetic_data.py (labels, graphs and README are kept)
edusync/packages/c2/data/synthetic/*.pptx
edusync/packages/c2/data/synthetic/*.pdf
