# EduSync API behind BigBlueButton's HTTPS (https://<BBB_HOSTNAME>/edusync/).
# Port 8100 itself is blocked by the BBB image's ufw firewall, and this keeps the API on the same
# origin as the HTML5 client. Mounted to /etc/bigbluebutton/nginx/ by docker-compose.yml.
location /edusync/ {
  proxy_pass http://127.0.0.1:8100/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_read_timeout 300s;
  client_max_body_size 200m;
}
